            "Chatgpt-Account-Id": "{cred.id_token.chatgpt_account_id|metadata.id_token.chatgpt_account_id|attributes.id_token.chatgpt_account_id}{jwt:id_token|metadata.id_token|attributes.id_token:chatgpt_account_id}",
            "Accept": "application/json",
