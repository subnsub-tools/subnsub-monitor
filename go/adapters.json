          "window_seconds": "limit_window_seconds|limitWindowSeconds",
          "resets": "reset_at|resetAt|reset_after_seconds|resetAfterSeconds"
        },
        {
          "from": "usage",
          "base": "rate_limit.secondary_window|rateLimit.secondaryWindow",
          "key": "secondary",
          "used": "used_percent|usedPercent",
          "window_seconds": "limit_window_seconds|limitWindowSeconds",
